# Local development with `npm run db:local` (PostgreSQL on port 5433, no install needed).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ielts"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/ielts"

# Production (Supabase) — set these in Vercel, not here:
#   DATABASE_URL = transaction pooler (port 6543) + "?pgbouncer=true&connection_limit=1"
#   DIRECT_URL   = session pooler (port 5432), used for migrations

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
PORT=4000

# Optional. Only needed if the frontend is hosted on a different origin from the API.
# FRONTEND_ORIGIN="http://localhost:5173"

# Phase 2+ (Writing/Speaking AI grading) - not required for Phase 1
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-5"
